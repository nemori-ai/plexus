;; ============================================================================
;; codex-confine.sb — the macOS seatbelt profile that kernel-jails a headless
;; Codex run (`codex.run`, policy "jail") to one authorized directory.
;;
;; The Codex analog of `sources/claudecode/sandbox/cc-confine.sb`. Inside the JAIL
;; the run reads and writes freely and does real work; every read or write outside
;; it fails at the kernel with `Operation not permitted`, even when Codex itself is
;; prompted to escape. The kernel, not Codex's own sandbox, is the trust boundary.
;; Codex's own sandbox must be OFF inside this one (`--sandbox danger-full-access`):
;; nesting its `workspace-write` seatbelt inside this profile makes every shell
;; command fail with "sandbox initialization denied".
;;
;; Params injected at launch via `-D` (the launcher owns all of them):
;;   JAIL            the authorized ROOT (realpath). The only broad read+write subtree.
;;   HOMEDIR         the owner's $HOME (Keychain).
;;   TOOL_HOME       Codex's state dir (`$CODEX_HOME` or `~/.codex`). Writable, because
;;                   Codex hangs when it cannot write its sqlite state and logs, EXCEPT
;;                   the entries that change its behaviour, which stay read-only (the
;;                   deny block at the end; keep it in step with CODEX_PROTECTED_STATE
;;                   in `sources/codex/launcher.ts`).
;;   TOOL_BIN_DIR    the dir holding the resolved `codex` entry point (read-only).
;;   TOOL_PKG_DIR    the enclosing `node_modules` (or install root) that holds the
;;                   platform binary package (read-only).
;;   TOOL_INTERP_DIR the dir of the `node` the `#!/usr/bin/env node` wrapper resolves
;;                   (read-only). The launcher points an unused one at JAIL (a no-op).
;;
;; TMPDIR points INSIDE the jail (`<JAIL>/.tmp`); no system temp is granted.
;;
;; Rule precedence: a LATER rule wins, so every deny must follow the allow it narrows.
;; ============================================================================
(version 1)
(deny default)
(import "/System/Library/Sandbox/Profiles/bsd.sb")

(allow process-exec*)
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow iokit-open)
(allow mach-lookup)        ; securityd (Keychain), DNS resolver, etc.
(allow network*)           ; the model API. Network stays open under the jail.

;; ---- read-only system paths the tool needs to run ----
(allow file-read*
  (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/System") (subpath "/Library")
  (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone")
  (subpath "/private/var/db/mds")
  (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom")
  (literal "/dev/dtracehelper") (literal "/dev/tty")
  (subpath "/private/etc") (subpath "/opt/homebrew")
  (subpath (param "TOOL_BIN_DIR"))
  (subpath (param "TOOL_PKG_DIR"))
  (subpath (param "TOOL_INTERP_DIR")))

;; ---- the tool's own state: read + write (sqlite state, logs, sessions) ----
(allow file-read* (subpath (param "TOOL_HOME")))
(allow file-write* (subpath (param "TOOL_HOME")))

;; ---- Keychain (credential read + refresh) ----
(allow file-read* file-write*
  (subpath (string-append (param "HOMEDIR") "/Library/Keychains")))
(allow user-preference-read)
(allow user-preference-write)

;; ================= THE JAIL: the only broad read+write =================
(allow file-read* (subpath (param "JAIL")))
(allow file-write* (subpath (param "JAIL")))

(allow file-ioctl (literal "/dev/tty"))

;; ---- the entries of TOOL_HOME that change Codex's behaviour stay read-only ----
;; (last so they win over the TOOL_HOME write grant above)
(deny file-write*
  (literal (string-append (param "TOOL_HOME") "/config.toml"))
  (literal (string-append (param "TOOL_HOME") "/hooks.json"))
  (literal (string-append (param "TOOL_HOME") "/AGENTS.md"))
  (subpath (string-append (param "TOOL_HOME") "/hooks"))
  (subpath (string-append (param "TOOL_HOME") "/plugins"))
  (subpath (string-append (param "TOOL_HOME") "/skills"))
  (subpath (string-append (param "TOOL_HOME") "/rules"))
  (subpath (string-append (param "TOOL_HOME") "/prompts")))
