;; ============================================================================
;; codex-confine.sb — the macOS seatbelt profile that kernel-jails a headless
;; Codex run (`codex.run`, policy "jail") to one authorized directory.
;;
;; Params injected at launch via `-D` (the launcher owns all of them):
;;   JAIL            the authorized ROOT (realpath). The only broad read+write subtree.
;;   HOMEDIR         the owner's $HOME (Keychain).
;;   TOOL_HOME       Codex's state dir (`$CODEX_HOME` or `~/.codex`). Its login and
;;                   configuration are readable; the configuration and the cross-session
;;                   stores are never writable (CODEX_PROTECTED_STATE,
;;                   CODEX_PROTECTED_SQLITE); the owner's past threads and shell are
;;                   not readable at all while this run still creates and appends its
;;                   own rollout, history line and index entry (CODEX_PRIVATE_STATE and
;;                   every `*.sqlite*` store). The deny blocks at the end encode this;
;;                   keep them in step with `sources/codex/launcher.ts`.
;;   TOOL_BIN_DIR    the dir holding the resolved `codex` entry point (read-only).
;;   TOOL_PKG_DIR    the enclosing `node_modules` (or install root) that holds the
;;                   platform binary package (read-only).
;;   TOOL_INTERP_DIR the dir of the `node` the `#!/usr/bin/env node` wrapper resolves
;;                   (read-only). The launcher points an unused one at JAIL (a no-op).
;;
;; TMPDIR points INSIDE the jail (`<JAIL>/.tmp`); no system temp is granted.
;;
;; Rule precedence: a LATER rule wins, so every deny must follow the allow it narrows.
;; ============================================================================
(version 1)
(deny default)
(import "/System/Library/Sandbox/Profiles/bsd.sb")

(allow process-exec*)
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow iokit-open)
(allow mach-lookup)
;; The owner's clipboard is not the run's to read or write (pbcopy/pbpaste, NSPasteboard).
(deny mach-lookup
  (global-name "com.apple.pasteboard.1")
  (global-name "com.apple.pboard"))
(allow network*)

(allow file-read*
  (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/System") (subpath "/Library")
  (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone")
  (subpath "/private/var/db/mds")
  (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom")
  (literal "/dev/dtracehelper") (literal "/dev/tty")
  (subpath "/private/etc") (subpath "/opt/homebrew")
  (subpath (param "TOOL_BIN_DIR"))
  (subpath (param "TOOL_PKG_DIR"))
  (subpath (param "TOOL_INTERP_DIR")))

(allow file-read* (subpath (param "TOOL_HOME")))
(allow file-write* (subpath (param "TOOL_HOME")))

(allow file-read* file-write*
  (subpath (string-append (param "HOMEDIR") "/Library/Keychains")))
(allow user-preference-read)
(allow user-preference-write)

(allow file-read* (subpath (param "JAIL")))
(allow file-write* (subpath (param "JAIL")))

(allow file-ioctl (literal "/dev/tty"))

(deny file-write*
  (literal (string-append (param "TOOL_HOME") "/config.toml"))
  (literal (string-append (param "TOOL_HOME") "/hooks.json"))
  (literal (string-append (param "TOOL_HOME") "/AGENTS.md"))
  (subpath (string-append (param "TOOL_HOME") "/hooks"))
  (subpath (string-append (param "TOOL_HOME") "/plugins"))
  (subpath (string-append (param "TOOL_HOME") "/skills"))
  (subpath (string-append (param "TOOL_HOME") "/rules"))
  (subpath (string-append (param "TOOL_HOME") "/prompts")))

;; Codex's cross-session stores (`memories_<n>.sqlite`, `goals_<n>.sqlite` and their
;; -wal/-shm/-journal): injected into the owner's future sessions, so never writable.
;; Keep the families in step with CODEX_PROTECTED_SQLITE in `sources/codex/launcher.ts`.
(deny file-write*
  (regex (string-append "^" (param "TOOL_HOME") "/(memories|goals)[^/]*\\.sqlite")))

;; The owner's private state: past threads and the owner's shell. Only `file-read-data`
;; is denied, so Codex still creates and appends its own rollout, history line and index
;; entry there (lookup, stat and mkdir need metadata only) and cannot read any of it back.
;; Keep the names, their kinds and their order in step with CODEX_PRIVATE_STATE.
(deny file-read-data
  (literal (string-append (param "TOOL_HOME") "/history.jsonl"))
  (literal (string-append (param "TOOL_HOME") "/session_index.jsonl"))
  (subpath (string-append (param "TOOL_HOME") "/sessions"))
  (subpath (string-append (param "TOOL_HOME") "/archived_sessions"))
  (subpath (string-append (param "TOOL_HOME") "/shell_snapshots"))
  (subpath (string-append (param "TOOL_HOME") "/log"))
  (subpath (string-append (param "TOOL_HOME") "/.tmp"))
  (subpath (string-append (param "TOOL_HOME") "/tmp"))
  (subpath (string-append (param "TOOL_HOME") "/generated_images"))
  (regex (string-append "^" (param "TOOL_HOME") "/[^/]*\\.sqlite")))
