;; ============================================================================
;; cc-confine.sb — the macOS seatbelt profile that kernel-jails a headless
;; Claude Code run (`claudecode.run`, policy "jail") to one authorized directory.
;;
;; Params injected at launch via `-D` (the launcher owns all of them):
;;   JAIL            the authorized ROOT (realpath). The only broad read+write subtree.
;;   HOMEDIR         the owner's $HOME (Keychain + `~/.claude.json`).
;;   TOOL_HOME       Claude Code's state dir (`$CLAUDE_CONFIG_DIR` or `~/.claude`).
;;                   Its login and configuration (`settings.json`, hooks, plugins,
;;                   skills, rules) are readable and never writable, so the run works
;;                   as the owner's own. The owner's private state in it (past
;;                   transcripts, prompt history, pastes, file snapshots, the
;;                   auto-memory, other instances' keys: the deny list at the end,
;;                   kept in step with CC_PRIVATE_STATE in
;;                   `sources/claudecode/launcher.ts`) is not readable at all.
;;   CC_SESSION_FILE this run's transcript, `projects/<slug>/<session-id>.jsonl` (the
;;                   owner's `--resume` handle). The only writable file under TOOL_HOME.
;;   CC_SESSION_DIR  this run's per-session dir, `projects/<slug>/<session-id>/`.
;;   TOOL_BIN_DIR    the dir holding the resolved `claude` binary (read-only).
;;   TOOL_PKG_DIR    the install root one level up (read-only).
;;   TOOL_INTERP_DIR the script interpreter's dir when `claude` is a script
;;                   (read-only). The launcher points an unused one at JAIL (a no-op).
;;
;; TMPDIR and CLAUDE_CODE_TMPDIR point INSIDE the jail (`<JAIL>/.tmp`); no system
;; temp is granted.
;;
;; Rule precedence: a LATER rule wins, so every deny must follow the allow it narrows,
;; and the re-grant of this run's transcript must follow the deny of `projects/`.
;; ============================================================================
(version 1)
(deny default)
(import "/System/Library/Sandbox/Profiles/bsd.sb")

(allow process-exec*)
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow iokit-open)
(allow mach-lookup)
;; The owner's clipboard is not the run's to read or write (pbcopy/pbpaste, NSPasteboard).
(deny mach-lookup
  (global-name "com.apple.pasteboard.1")
  (global-name "com.apple.pboard"))
(allow network*)

(allow file-read*
  (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/System") (subpath "/Library")
  (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone")
  (subpath "/private/var/db/mds")
  (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom")
  (literal "/dev/dtracehelper") (literal "/dev/tty")
  (subpath "/private/etc") (subpath "/opt/homebrew")
  (subpath (param "TOOL_BIN_DIR"))
  (subpath (param "TOOL_PKG_DIR"))
  (subpath (param "TOOL_INTERP_DIR")))

(allow file-read*
  (subpath (param "TOOL_HOME"))
  (literal (string-append (param "HOMEDIR") "/.claude.json"))
  (literal (string-append (param "TOOL_HOME") "/.claude.json")))

(allow file-read* file-write*
  (subpath (string-append (param "HOMEDIR") "/Library/Keychains")))
(allow user-preference-read)
(allow user-preference-write)

(allow file-read* (subpath (param "JAIL")))
(allow file-write* (subpath (param "JAIL")))

(allow file-ioctl (literal "/dev/tty"))

;; The owner's private state: past sessions and the keys of other instances. Keep the
;; names, their kinds and their order in step with CC_PRIVATE_STATE.
(deny file-read*
  (subpath (string-append (param "TOOL_HOME") "/projects"))
  (literal (string-append (param "TOOL_HOME") "/history.jsonl"))
  (subpath (string-append (param "TOOL_HOME") "/file-history"))
  (subpath (string-append (param "TOOL_HOME") "/paste-cache"))
  (subpath (string-append (param "TOOL_HOME") "/uploads"))
  (subpath (string-append (param "TOOL_HOME") "/image-cache"))
  (subpath (string-append (param "TOOL_HOME") "/plans"))
  (subpath (string-append (param "TOOL_HOME") "/tasks"))
  (subpath (string-append (param "TOOL_HOME") "/todos"))
  (subpath (string-append (param "TOOL_HOME") "/dev-mods"))
  (subpath (string-append (param "TOOL_HOME") "/usage-data"))
  (subpath (string-append (param "TOOL_HOME") "/feedback"))
  (subpath (string-append (param "TOOL_HOME") "/feedback-bundles"))
  (subpath (string-append (param "TOOL_HOME") "/debug"))
  (subpath (string-append (param "TOOL_HOME") "/logs"))
  (subpath (string-append (param "TOOL_HOME") "/session-env"))
  (subpath (string-append (param "TOOL_HOME") "/shell-snapshots"))
  (subpath (string-append (param "TOOL_HOME") "/agent-memory"))
  (subpath (string-append (param "TOOL_HOME") "/transcripts"))
  (subpath (string-append (param "TOOL_HOME") "/teams"))
  (subpath (string-append (param "TOOL_HOME") "/jobs"))
  (subpath (string-append (param "TOOL_HOME") "/daemon"))
  (literal (string-append (param "TOOL_HOME") "/daemon.log"))
  (subpath (string-append (param "TOOL_HOME") "/sessions"))
  (subpath (string-append (param "TOOL_HOME") "/ide"))
  (subpath (string-append (param "TOOL_HOME") "/channels"))
  (subpath (string-append (param "TOOL_HOME") "/backups"))
  (subpath (string-append (param "TOOL_HOME") "/downloads")))

;; This run's own transcript, back out of the hidden `projects/`.
(allow file-read* file-write*
  (literal (param "CC_SESSION_FILE"))
  (subpath (param "CC_SESSION_DIR")))
